SET @load = RequestParameter("load")
]%%
<script runat="server">
Platform.Load("Core", "1.1.1");
var automationData = [];
var folderOptions = [];
var errorMessage = "";
var shouldLoad = false;
var totalCount = 0;
var scheduledCount = 0;
var runningCount = 0;
var pausedCount = 0;
var stoppedCount = 0;
var readyCount = 0;
var errorCount = 0;

var statusMap = {
  "-1": "Error",
  "0": "Building Error",
  "1": "Building",
  "2": "Ready",
  "3": "Running",
  "4": "Paused",
  "5": "Stopped",
  "6": "Scheduled",
  "7": "Awaiting Trigger",
  "8": "Inactive Trigger"
};

function safe(value) {
  if (value === null || value === undefined) return "";
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function formatDate(value) {
  if (!value || String(value).indexOf("0001-01-01") === 0) {
    return "N/A";
  }
  try {
    var d = new Date(value);
    if (isNaN(d.getTime())) {
      return String(value);
    }
    var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var day = d.getDate();
    var month = months[d.getMonth()];
    var year = d.getFullYear();
    return (day < 10 ? "0" + day : day) + " " + month + " " + year;
  } catch (e) {
    return String(value);
  }
}

function retrieveRows(api, objectType, cols, filter) {
  var rows = [];
  var reqId = null;
  var hasMore = true;
  var guard = 0;
  while (hasMore && guard < 150) {
    guard++;
    var res;
    if (reqId == null) {
      res = filter ? api.retrieve(objectType, cols, filter) : api.retrieve(objectType, cols);
    } else {
      res = api.getNextBatch(objectType, reqId);
    }
    if (!res) {
      throw "Null response from " + objectType;
    }
    if (res.Status == "Error") {
      throw res.StatusMessage || ("Error retrieving " + objectType);
    }
    if (res.Results && res.Results.length) {
      for (var i = 0; i < res.Results.length; i++) {
        rows.push(res.Results[i]);
      }
    }
    hasMore = (res.HasMoreRows == true);
    reqId = res.RequestID || null;
    if (hasMore && !reqId) {
      break;
    }
  }
  return rows;
}

function buildFolderMap(api) {
  var mapById = {};
  var folderCols = ["ID", "Name", "ParentFolder.ID", "ParentFolder.Name", "ContentType"];
  var folders = retrieveRows(api, "DataFolder", folderCols, null);

  for (var i = 0; i < folders.length; i++) {
    var f = folders[i];
    if (!f) continue;

    var rawId = (f.ID !== null && f.ID !== undefined) ? f.ID : f["ID"];
    if (rawId === null || rawId === undefined || String(rawId) === "") continue;
    var id = String(rawId);

    var rawParentId = "";
    var rawParentName = "";

    if (f.ParentFolder) {
      if (f.ParentFolder.ID !== null && f.ParentFolder.ID !== undefined) {
        rawParentId = String(f.ParentFolder.ID);
      }
      if (f.ParentFolder.Name) {
        rawParentName = String(f.ParentFolder.Name);
      }
    }
    if (!rawParentId && f["ParentFolder.ID"] !== undefined && f["ParentFolder.ID"] !== null) {
      rawParentId = String(f["ParentFolder.ID"]);
    }
    if (!rawParentName && f["ParentFolder.Name"]) {
      rawParentName = String(f["ParentFolder.Name"]);
    }

    if (rawParentId === "0") {
      rawParentId = "";
    }

    var rawName = f.Name || f["Name"] || ("Folder (" + id + ")");

    mapById[id] = {
      id: id,
      name: String(rawName),
      parentId: rawParentId,
      parentName: rawParentName,
      location: ""
    };
  }

  for (var key in mapById) {
    if (!mapById.hasOwnProperty(key)) continue;
    var parts = [];
    var visited = {};
    var curr = key;

    while (curr && mapById[curr] && !visited[curr]) {
      visited[curr] = true;
      parts.unshift(mapById[curr].name);
      var nextParent = mapById[curr].parentId;
      if (nextParent && mapById[nextParent]) {
        curr = nextParent;
      } else {
        if (mapById[curr].parentName && parts[0] !== mapById[curr].parentName) {
          parts.unshift(mapById[curr].parentName);
        }
        break;
      }
    }

    mapById[key].location = parts.join(" / ");
  }

  return mapById;
}

try {
  var loadParam = Variable.GetValue("@load");
  shouldLoad = (String(loadParam) == "1");
  if (shouldLoad) {
    var api = new Script.Util.WSProxy();
    var folderMap = buildFolderMap(api);
    var cols = [
      "Name",
      "CustomerKey",
      "Status",
      "CategoryID",
      "CreatedDate",
      "ModifiedDate"
    ];
    var filter = {
      Property: "Status",
      SimpleOperator: "IN",
      Value: [-1, 0, 1, 2, 3, 4, 5, 6, 7, 8]
    };
    var items = retrieveRows(api, "Automation", cols, filter);
    var seenFolders = {};

    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      var statusCode = String(item.Status);
      var statusName = statusMap[statusCode] || "Unknown";
      var categoryId = (item.CategoryID !== null && item.CategoryID !== undefined) ? String(item.CategoryID) : "";
      var folderInfo = folderMap[categoryId];
      var folderName = folderInfo ? folderInfo.name : (categoryId ? "Folder (" + categoryId + ")" : "Unassigned");
      var locationPath = (folderInfo && folderInfo.location) ? folderInfo.location : folderName;

      automationData.push({
        name: item.Name || "",
        status: statusName,
        folder: folderName,
        location: locationPath,
        createdDate: item.CreatedDate || "",
        modifiedDate: item.ModifiedDate || "",
        key: item.CustomerKey || ""
      });

      if (!seenFolders[locationPath]) {
        seenFolders[locationPath] = true;
        folderOptions.push({
          value: locationPath.toLowerCase(),
          label: locationPath
        });
      }

      totalCount++;
      if (statusCode == "6") scheduledCount++;
      if (statusCode == "3") runningCount++;
      if (statusCode == "4") pausedCount++;
      if (statusCode == "5") stoppedCount++;
      if (statusCode == "2") readyCount++;
      if (statusCode == "-1" || statusCode == "0") errorCount++;
    }

    folderOptions.sort(function(a, b) {
      return a.label.localeCompare(b.label);
    });

    automationData.sort(function(a, b) {
      var dateA = a.modifiedDate ? new Date(a.modifiedDate).getTime() : 0;
      var dateB = b.modifiedDate ? new Date(b.modifiedDate).getTime() : 0;
      return dateB - dateA;
    });
  }
} catch (e) {
  errorMessage = String(e);
}
</script>

<div class="container">
  <div class="header-title">
    <div>
      <h2><span style="font-size:26px;">TGS</span> Automation Status Dashboard</h2>
    </div>
    <form method="GET">
      <input type="hidden" name="load" value="1">
      <button type="submit" class="search-btn">Load Automations</button>
    </form>
  </div>

  <div class="dashboard" role="group" aria-label="Filter automations by status">
    <button type="button" class="card total active" data-status="" onclick="selectStatus(this)">
      <p>Total</p>
      <h3><script runat="server">Write(totalCount);</script></h3>
    </button>
    <button type="button" class="card scheduled" data-status="scheduled" onclick="selectStatus(this)">
      <p>Scheduled</p>
      <h3><script runat="server">Write(scheduledCount);</script></h3>
    </button>
    <button type="button" class="card running" data-status="running" onclick="selectStatus(this)">
      <p>Running</p>
      <h3><script runat="server">Write(runningCount);</script></h3>
    </button>
    <button type="button" class="card paused" data-status="paused" onclick="selectStatus(this)">
      <p>Paused</p>
      <h3><script runat="server">Write(pausedCount);</script></h3>
    </button>
    <button type="button" class="card stopped" data-status="stopped" onclick="selectStatus(this)">
      <p>Stopped</p>
      <h3><script runat="server">Write(stoppedCount);</script></h3>
    </button>
    <button type="button" class="card ready" data-status="ready" onclick="selectStatus(this)">
      <p>Ready</p>
      <h3><script runat="server">Write(readyCount);</script></h3>
    </button>
    <button type="button" class="card stopped" data-status="error" onclick="selectStatus(this)">
      <p>Error</p>
      <h3><script runat="server">Write(errorCount);</script></h3>
    </button>
  </div>

  <div class="filter-bar">
    <input type="text" id="search" class="search-input" placeholder="Search automation name, folder, location, key, or status..." oninput="filterTable()" onkeyup="filterTable()">
    <select id="folderFilter" class="folder-select" onchange="filterTable()">
      <option value="">All Folders &amp; Locations</option>
      <script runat="server">
      for (var fIdx = 0; fIdx < folderOptions.length; fIdx++) {
        var opt = folderOptions[fIdx];
        Write("<option value=\"" + safe(opt.value) + "\">" + safe(opt.label) + "</option>");
      }
      </script>
    </select>
  </div>

  <div class="error">
    <script runat="server">
    if (errorMessage !== "") {
      Write("ERROR: " + safe(errorMessage));
    }
    </script>
  </div>

  <div class="table-container">
    <table id="automationTable">
      <thead>
        <tr>
          <th>#</th>
          <th>Automation Name</th>
          <th>Status</th>
          <th>Folder</th>
          <th>Location</th>
          <th>Created Date</th>
          <th>Modified Date</th>
          <th>Customer Key</th>
        </tr>
      </thead>
      <tbody>
        <script runat="server">
        for (var j = 0; j < automationData.length; j++) {
          var a = automationData[j];
          var badgeColor = "#64748B";
          if (a.status == "Running") badgeColor = "#10B981";
          if (a.status == "Scheduled") badgeColor = "#06B6D4";
          if (a.status == "Paused") badgeColor = "#F59E0B";
          if (a.status == "Stopped" || a.status == "Error") badgeColor = "#EF4444";
          if (a.status == "Ready") badgeColor = "#10B981";

          Write("<tr data-folder=\"" + safe(a.location.toLowerCase()) + "\" data-status=\"" + safe(a.status.toLowerCase()) + "\">");
          Write("<td style='text-align:center; color:#64748b;'>" + (j + 1) + "</td>");
          Write("<td><strong>" + safe(a.name) + "</strong></td>");
          Write("<td><span class='badge' style='background:" + badgeColor + "'>" + safe(a.status) + "</span></td>");
          Write("<td><strong>" + safe(a.folder) + "</strong></td>");
          Write("<td><span class='location-path'>" + safe(a.location) + "</span></td>");
          Write("<td style='color:#64748b;'>" + safe(formatDate(a.createdDate)) + "</td>");
          Write("<td style='color:#64748b;'>" + safe(formatDate(a.modifiedDate)) + "</td>");
          Write("<td><code>" + safe(a.key) + "</code></td>");
          Write("</tr>");
        }
        if (automationData.length === 0 && errorMessage === "" && shouldLoad) {
          Write("<tr><td colspan='8' style='text-align: center; color: #64748B; padding: 20px;'>No automation records found.</td></tr>");
        }
        </script>
      </tbody>
    </table>
  </div>
</div>

<script>
var selectedStatus = "";

function selectStatus(cardEl) {
  var clickedStatus = (cardEl.getAttribute("data-status") || "").toLowerCase();

  if (clickedStatus === "" || selectedStatus === clickedStatus) {
    selectedStatus = "";
  } else {
    selectedStatus = clickedStatus;
  }

  var cards = document.querySelectorAll(".dashboard .card");
  cards.forEach(function(card) {
    var cardStatus = (card.getAttribute("data-status") || "").toLowerCase();
    if (cardStatus === selectedStatus) {
      card.classList.add("active");
    } else {
      card.classList.remove("active");
    }
  });

  filterTable();
}

function filterTable() {
  var searchEl = document.getElementById("search");
  var folderEl = document.getElementById("folderFilter");
  var query = searchEl ? searchEl.value.toLowerCase().trim() : "";
  var selectedFolder = folderEl ? folderEl.value.toLowerCase() : "";
  var rows = document.querySelectorAll("#automationTable tbody tr");

  rows.forEach(function(row) {
    if (!row.hasAttribute("data-status")) return;

    var rowText = (row.textContent || row.innerText || "").toLowerCase();
    var rowFolder = (row.getAttribute("data-folder") || "").toLowerCase();
    var rowStatus = (row.getAttribute("data-status") || "").toLowerCase();

    var matchesText = !query || rowText.indexOf(query) !== -1;
    var matchesFolder = !selectedFolder || rowFolder === selectedFolder || rowFolder.indexOf(selectedFolder + " / ") === 0;
    var matchesStatus = !selectedStatus || rowStatus === selectedStatus;

    row.style.display = (matchesText && matchesFolder && matchesStatus) ? "" : "none";
  });
}
</script>
