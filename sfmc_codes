<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SFMC Automation Monitoring Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<style>
:root {
  --primary: #4F46E5;
  --primary-hover: #4338CA;
  --bg-color: #F8FAFC;
  --card-bg: #FFFFFF;
  --text-main: #1E293B;
  --text-muted: #64748B;
  --border-color: #CBD5E1;
  --success: #10B981;
  --warning: #F59E0B;
  --danger: #EF4444;
  --info: #06B6D4;
  --radius: 8px;
  --shadow: 0 2px 4px -1px rgba(0, 0, 0, 0.06), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
}
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
body {
  font-family: 'Inter', sans-serif;
  background-color: var(--bg-color);
  color: var(--text-main);
  padding: 16px;
  font-size: 0.85rem;
  line-height: 1.4;
}
.container {
  max-width: 1360px;
  margin: 0 auto;
}
.header-title {
  margin-bottom: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}
.header-title h2 {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-main);
}
.header-title h2 span {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--primary);
  display: block;
}
.search-btn {
  background-color: var(--primary);
  color: white;
  border: none;
  padding: 8px 16px;
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: var(--radius);
  cursor: pointer;
  transition: background-color 0.2s;
}
.search-btn:hover {
  background-color: var(--primary-hover);
}
.dashboard {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 10px;
  margin-bottom: 14px;
}
.card {
  background: var(--card-bg);
  padding: 10px 12px;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1.5px solid #E2E8F0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-align: left;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
}
.card:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 8px -2px rgba(0, 0, 0, 0.08);
  border-color: #94A3B8;
}
.card:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}
.card.active {
  border-color: var(--primary);
  background-color: #EEF2FF;
  box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.18);
}
.card.scheduled.active { border-color: var(--info); background-color: #ECFEFF; }
.card.running.active { border-color: var(--success); background-color: #ECFDF5; }
.card.paused.active { border-color: var(--warning); background-color: #FFFBEB; }
.card.stopped.active { border-color: var(--danger); background-color: #FEF2F2; }
.card.ready.active { border-color: var(--success); background-color: #ECFDF5; }
.card p {
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.025em;
}
.card h3 {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-main);
  margin-top: 2px;
}
.card.scheduled h3 { color: var(--info); }
.card.running h3 { color: var(--success); }
.card.paused h3 { color: var(--warning); }
.card.stopped h3 { color: var(--danger); }
.card.ready h3 { color: var(--success); }
.filter-bar {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 10px;
  margin-bottom: 14px;
}
@media (max-width: 720px) {
  .filter-bar {
    grid-template-columns: 1fr;
  }
}
.search-input,
.folder-select {
  width: 100%;
  padding: 10px 14px;
  font-size: 0.85rem;
  border: 1px solid #E2E8F0;
  border-radius: var(--radius);
  background-color: var(--card-bg);
  color: var(--text-main);
  box-shadow: var(--shadow);
  outline: none;
  transition: border-color 0.2s;
}
.search-input:focus,
.folder-select:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.15);
}
.error {
  color: var(--danger);
  background-color: #FEF2F2;
  border: 1px solid #FECACA;
  padding: 10px;
  border-radius: var(--radius);
  margin-bottom: 14px;
  font-weight: 500;
  font-size: 0.8rem;
}
.error:empty {
  display: none;
}
.table-container {
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1px solid var(--border-color);
  overflow-x: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  table-layout: auto;
}
th {
  background-color: #E2E8F0;
  color: #334155;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.05em;
  padding: 10px 12px;
  border-bottom: 2px solid #94A3B8;
  border-right: 1px solid #CBD5E1;
}
th:last-child {
  border-right: none;
}
td {
  padding: 10px 12px;
  border-bottom: 1.5px solid var(--border-color);
  border-right: 1px solid #E2E8F0;
  color: var(--text-main);
  font-size: 0.8rem;
  word-break: break-word;
  white-space: normal;
  vertical-align: top;
  transition: background-color 0.15s ease;
}
td:last-child {
  border-right: none;
}

/* Subtle column tints for quick visual scanning */
#automationTable tbody td:nth-child(1) { background-color: #F8FAFC; }
#automationTable tbody td:nth-child(2) { background-color: #EEF2FF; }
#automationTable tbody td:nth-child(3) { background-color: #F8FAFC; }
#automationTable tbody td:nth-child(4) { background-color: #F0FDF4; }
#automationTable tbody td:nth-child(5) { background-color: #F0F9FF; }
#automationTable tbody td:nth-child(6) { background-color: #FAFAFA; }
#automationTable tbody td:nth-child(7) { background-color: #FAFAFA; }
#automationTable tbody td:nth-child(8) { background-color: #FFFBEB; }

/* Table-row-only hover highlight */
#automationTable tbody tr:hover > td {
  background-color: #E2E8F0;
}
#automationTable tbody tr[data-status="scheduled"]:hover > td {
  background-color: #CFFAFE;
}
#automationTable tbody tr[data-status="running"]:hover > td {
  background-color: #D1FAE5;
}

tbody tr:last-child td {
  border-bottom: none;
}

th:nth-child(1), td:nth-child(1) { width: 4%; text-align: center; }
th:nth-child(2), td:nth-child(2) { width: 22%; }
th:nth-child(3), td:nth-child(3) { width: 11%; }
th:nth-child(4), td:nth-child(4) { width: 14%; }
th:nth-child(5), td:nth-child(5) { width: 23%; }
th:nth-child(6), td:nth-child(6) { width: 110px; }
th:nth-child(7), td:nth-child(7) { width: 110px; }
th:nth-child(8), td:nth-child(8) { width: 15%; }

.location-path {
  font-size: 0.75rem;
  color: #334155;
}
.badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 9999px;
  font-size: 0.7rem;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  white-space: nowrap;
}
code {
  font-family: monospace;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid #FDE68A;
  padding: 2px 5px;
  border-radius: 4px;
  font-size: 0.75rem;
  word-break: break-all;
}
</style>

